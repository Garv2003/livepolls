# Copy to .env and fill in. Never commit real secrets.

# --- client (Next.js) ---
# URL of the realtime socket.io server (inlined at build time).
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
# Upstash Redis (REST) — used by the client's server actions to store topics/comments.
# Create a free database at https://console.upstash.com and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- server (socket.io + Redis pub/sub) ---
# Redis connection string for pub/sub. docker-compose provides one at redis://redis:6379.
REDIS_CONNECTION_STRING=redis://localhost:6379
# Port the realtime server binds to.
PORT=8080
# Comma-separated allowed client origins for CORS.
CLIENT_ORIGIN=http://localhost:3000
